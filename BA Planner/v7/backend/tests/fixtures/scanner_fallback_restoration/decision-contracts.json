{
  "schema_version": 1,
  "scope": "F0 approved target contract; not current runtime protocol",
  "decisions": {
    "D1": {
      "status": "user_confirmed_2026-08-30",
      "policy": "automatic calibration is session-local; only explicit user-confirmed samples persist",
      "key": [
        "profile_id",
        "actual_capture_width",
        "actual_capture_height",
        "session_id",
        "generation",
        "student_ref",
        "field"
      ],
      "eligibility": [
        "same student and form",
        "target detail panel verified",
        "independent confirmed value",
        "no contradiction with existing confirmed value"
      ],
      "precedence": [
        "user_confirmed",
        "eligible_session_calibration",
        "bundled"
      ],
      "discard_on": [
        "cancel",
        "terminal",
        "profile_change",
        "capture_resolution_change"
      ],
      "forbidden": [
        "automatic persistent writes",
        "calibration output as own training label",
        "claiming automatic sample is user confirmed"
      ]
    },
    "D2": {
      "status": "legacy_characterized_current_bank_promotion_deferred_to_F7",
      "legacy": {
        "normal_tier_score": 0.72,
        "fallback_score": 0.66,
        "level": 70,
        "top_candidate": "T10",
        "scan_level_required": true,
        "source": "inferred",
        "note": "level70_implies_t10"
      },
      "current_bank_promotion": false,
      "required_before_F7": [
        "independent positive and negative real tier crops",
        "blank/noise/tie/incorrect-family negatives",
        "separate calibration and validation sets",
        "bounded field-specific inferred source; never globally lower threshold"
      ]
    },
    "D3": {
      "status": "user_confirmed_2026-08-30",
      "policy": "unknown screen stops safely; normal screen plus failed fields stays partial; already collected candidates remain reviewable",
      "target_result": {
        "scope": "planned backend internal result DTO, not a protocol v1 extension",
        "fields": [
          "candidates",
          "outcome: completed|failed|cancelled",
          "error: code/message or null",
          "screen_state: basic_verified|panel_verified|unknown",
          "coverage_complete: boolean"
        ]
      },
      "publication": "publish fully collected candidates before the single terminal event; snapshot/candidate retain them after failure/cancel; monotonically increasing sequence",
      "retention": "session-memory review only, until session/service disposal; no automatic disk/profile writes",
      "candidate_rules": [
        "uncertain identity must not seed confirmed fields",
        "keep confirmed fields when fallback fails",
        "conflicting confirmed evidence requires review",
        "interrupted in-flight read is not a fully collected candidate",
        "retain per-form identity and provenance"
      ],
      "commit": "retain existing completed-session + review/revision checks; failed/cancelled retained candidates are not committable",
      "cancel": "cleanup-only bounded close/return; never start new exploration",
      "screen_unknown": "failed terminal with structured reason; no next student/panel/navigation",
      "field_failure": "partial evidence, absent value, continue only on verified screen",
      "inventory": "incomplete coverage prohibits zero-fill"
    }
  },

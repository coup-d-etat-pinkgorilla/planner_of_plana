{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baplanner.local/metadata/v1/resource_acquisition.schema.json",
  "title": "Reviewed KR acquisition table v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "resources"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "methods"
        ],
        "properties": {
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/method"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "kind",
        "label",
        "weekly_quantity",
        "selector_resource_keys",
        "source"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "stage",
            "shop",
            "conversion",
            "selector",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "weekly_quantity": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "selector_resource_keys": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "server",
            "reference",
            "reviewed_at"
          ],
          "properties": {
            "server": {
              "const": "KR"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "reviewed_at": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      }
    }
  }
}

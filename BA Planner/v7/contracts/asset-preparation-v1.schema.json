  "$defs": {
    "game": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "auto",
            "user",
            "none"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            null,
            "game_dir_not_found",
            "not_blue_archive",
            "catalog_missing",
            "catalog_invalid",
            "bundle_revision_missing",
            "bundle_revision_invalid",
            "bundle_revision_mismatch",
            "game_dir_unreadable"
          ]
        },
        "catalog_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "source",
        "valid",
        "reason",
        "catalog_sha256",
        "bundle_revision"
      ],
      "additionalProperties": false
    },

            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "assets_missing",
              "cancelled",
              "asset_cache_invalid",
              "asset_extract_failed",
              "result_not_saved"
            ]
          }
        }

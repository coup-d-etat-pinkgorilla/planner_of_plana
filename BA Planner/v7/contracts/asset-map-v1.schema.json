{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ba-planner.local/contracts/asset-map-v1.schema.json",
  "title": "BA Planner asset map v1 (M0 draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "status",
    "inventory",
    "catalogs",
    "assets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "status": {
      "const": "M0-draft"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedUi",
        "expectedRecognition",
        "actualUi",
        "actualRecognition",
        "recognitionDelta",
        "total",
        "ok",
        "manual"
      ],
      "properties": {
        "expectedUi": {
          "type": "integer",
          "minimum": 0
        },
        "expectedRecognition": {
          "type": "integer",
          "minimum": 0
        },
        "actualUi": {
          "type": "integer",
          "minimum": 0
        },
        "actualRecognition": {
          "type": "integer",
          "minimum": 0
        },
        "recognitionDelta": {
          "type": "integer"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "manual": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "catalogs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/catalog"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientKind",
        "versionId",
        "installedPath",
        "bytes",
        "sha256",
        "registeredSnapshot"
      ],
      "properties": {
        "clientKind": {
          "enum": [
            "jp",
            "steam"
          ]
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "installedPath": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registeredSnapshot": {
          "const": false
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannerPath",
        "role",
        "addressKey",
        "bundle",
        "textureName",
        "source",
        "clientKind",
        "note"
      ],
      "properties": {
        "plannerPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "role": {
          "enum": [
            "ui",
            "recognition"
          ]
        },
        "addressKey": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "bundle": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "textureName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source": {
          "enum": [
            "catalog",
            "manual"
          ]
        },
        "clientKind": {
          "enum": [
            "jp",
            "steam"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "catalog"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "addressKey": {
                "type": "string",
                "minLength": 1
              },
              "bundle": {
                "type": "string",
                "pattern": "^[^/\\\\]+\\.bundle$"
              }
            }
          },
          "else": {
            "properties": {
              "addressKey": {
                "type": "null"
              },
              "bundle": {
                "type": "null"
              },
              "textureName": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}

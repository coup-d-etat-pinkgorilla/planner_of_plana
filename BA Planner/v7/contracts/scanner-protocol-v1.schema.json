{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ba-planner.local/contracts/scanner-protocol-v1.schema.json",
  "title": "BA Planner scanner protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "sessionControl": {
      "type": "object",
      "required": [
        "accepted",
        "control_state",
        "reason",
        "terminal"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "control_state": {
          "enum": [
            "running",
            "pause_requested",
            "paused",
            "terminal"
          ]
        },
        "reason": {
          "enum": [
            "user",
            "input_detected",
            "target_minimized",
            null
          ]
        },
        "terminal": {
          "enum": [
            "completed",
            "cancelled",
            "failed",
            null
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "control_state": {
                "enum": [
                  "running",
                  "terminal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "user",
                  "input_detected",
                  "target_minimized"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control_state": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "properties": {
              "terminal": {
                "enum": [
                  "completed",
                  "cancelled",
                  "failed"
                ]
              },
              "accepted": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "terminal": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "sessionSnapshot": {
      "type": "object",
      "required": [
        "control_state",
        "reason",
        "terminal",
        "session_id",
        "generation",
        "scan_kind",
        "last_sequence",
        "events",
        "candidates"
      ],
      "properties": {
        "control_state": {
          "enum": [
            "running",
            "pause_requested",
            "paused",
            "terminal"
          ]
        },
        "reason": {
          "enum": [
            "user",
            "input_detected",
            "target_minimized",
            null
          ]
        },
        "terminal": {
          "enum": [
            "completed",
            "cancelled",
            "failed",
            null
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "scan_kind": {
          "enum": [
            "student",
            "inventory",
            "tactical_lobby"
          ]
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "control_state": {
                "enum": [
                  "running",
                  "terminal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "user",
                  "input_detected",
                  "target_minimized"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control_state": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "properties": {
              "terminal": {
                "enum": [
                  "completed",
                  "cancelled",
                  "failed"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "terminal": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "baseRequest": {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "type",
        "method",
        "payload"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "request"
        },
        "method": {
          "type": "string",
          "pattern": "^scanner\\."
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "baseResponse": {
      "type": "object",
      "required": [
        "protocol",
        "id",
        "type",
        "method",
        "payload"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "response"
        },
        "method": {
          "type": "string",
          "pattern": "^scanner\\."
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "sessionRef": {
      "type": "object",
      "required": [
        "session_id",
        "generation"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "fieldEvidence": {
      "type": "object",
      "required": [
        "field",
        "status",
        "source"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "inferred",
            "uncertain",
            "failed",
            "skipped",
            "region_missing",
            "verified",
            "deferred",
            "partial",
            "dependency_missing",
            "suspicious",
            "shadow"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "tacticalLobbyPayload": {
      "type": "object",
      "required": [
        "version",
        "roi_profile_id",
        "observed_at",
        "screen_hash",
        "refresh_generation",
        "frame_complete",
        "current_rank",
        "rows",
        "overall_confidence",
        "review_status"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "roi_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "screen_hash": {
          "type": "string",
          "minLength": 1
        },
        "refresh_generation": {
          "type": "string",
          "pattern": "^refresh-[0-9a-f]{24}$"
        },
        "frame_complete": {
          "type": "boolean"
        },
        "current_rank": {
          "type": "object",
          "required": [
            "value",
            "proposed_value",
            "confidence",
            "margin",
            "review_status"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "proposed_value": {
              "type": "integer",
              "minimum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "margin": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "review_status": {
              "enum": [
                "confirmed",
                "review_required"
              ]
            }
          },
          "additionalProperties": false
        },
        "rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "index",
              "rank",
              "opponent",
              "public_defense",
              "confidence",
              "review_status"
            ]
          }
        },
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "enum": [
            "confirmed",
            "review_required"
          ]
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "session_id",
        "generation",
        "revision",
        "scan_kind",
        "payload",
        "evidence",
        "review_required",
        "approved",
        "audit"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scan_kind": {
          "enum": [
            "student",
            "inventory",
            "tactical_lobby"
          ]
        },
        "payload": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldEvidence"
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "audit": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scan_kind": {
                "const": "tactical_lobby"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/tacticalLobbyPayload"
              }
            }
          }
        }
      ]
    },
    "errorPayload": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "unresolvedSlot": {
      "type": "object",
      "required": [
        "slot",
        "profile",
        "resolution",
        "crop_png_base64",
        "candidates"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0
        },
        "profile": {
          "enum": [
            "equipment",
            "activity_reports",
            "tech_notes",
            "tactical_bd",
            "ooparts",
            "presents",
            "student_elephs"
          ]
        },
        "resolution": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "crop_png_base64": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "identity",
              "score"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "request": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRequest"
        },
        {
          "oneOf": [
            {
              "properties": {
                "method": {
                  "const": "scanner.target.list"
                },
                "payload": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.recognition.status"
                },
                "payload": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.session.start"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "scan_kind",
                    "target_id"
                  ],
                  "properties": {
                    "scan_kind": {
                      "enum": [
                        "student",
                        "inventory",
                        "tactical_lobby"
                      ]
                    },
                    "target_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "profile_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "student_scan_mode": {
                      "enum": [
                        "single",
                        "full"
                      ]
                    },
                    "inventory_scan_profile": {
                      "enum": [
                        "equipment",
                        "activity_reports",
                        "tech_notes",
                        "tactical_bd",
                        "ooparts",
                        "presents",
                        "student_elephs"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.session.cancel"
                },
                "payload": {
                  "$ref": "#/$defs/sessionRef"
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.session.pause"
                },
                "payload": {
                  "$ref": "#/$defs/sessionRef"
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.session.resume"
                },
                "payload": {
                  "$ref": "#/$defs/sessionRef"
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.session.snapshot"
                },
                "payload": {
                  "$ref": "#/$defs/sessionRef"
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.candidate.get"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "candidate_id"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.candidate.review"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "candidate_id",
                    "expected_candidate_revision",
                    "candidate_payload",
                    "approve",
                    "reason"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_candidate_revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_payload": {
                      "type": "object"
                    },
                    "approve": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "relationship_ranks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    },
                    "confirmed_fields": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.candidate.revalidate"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "candidate_id",
                    "expected_candidate_revision"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_candidate_revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "relationship_ranks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.review.unresolved_slots"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "candidate_id"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.review.assign_identity"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "candidate_id",
                    "expected_candidate_revision",
                    "slot",
                    "identity",
                    "persist"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_candidate_revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "slot": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "identity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "persist": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.candidate.commit"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "candidate_id",
                    "candidate_revision",
                    "profile_id",
                    "expected_repository_revision",
                    "idempotency_key"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "candidate_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "candidate_revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "profile_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_repository_revision": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "idempotency_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          ]
        }
      ]
    },
    "response": {
      "allOf": [
        {
          "$ref": "#/$defs/baseResponse"
        },
        {
          "oneOf": [
            {
              "properties": {
                "method": {
                  "enum": [
                    "scanner.target.list",
                    "scanner.recognition.status",
                    "scanner.session.start",
                    "scanner.session.cancel",
                    "scanner.session.pause",
                    "scanner.session.resume",
                    "scanner.session.snapshot",
                    "scanner.candidate.get",
                    "scanner.candidate.review",
                    "scanner.candidate.revalidate",
                    "scanner.candidate.commit",
                    "scanner.review.unresolved_slots",
                    "scanner.review.assign_identity"
                  ]
                },
                "payload": {
                  "$ref": "#/$defs/errorPayload"
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.target.list"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "targets"
                  ],
                  "properties": {
                    "targets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "target_id",
                          "title",
                          "status"
                        ],
                        "properties": {
                          "target_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "title": {
                            "type": "string"
                          },
                          "status": {
                            "enum": [
                              "ready",
                              "minimized",
                              "closed",
                              "unsupported"
                            ]
                          },
                          "client_width": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 1
                          },
                          "client_height": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 1
                          },
                          "game": {
                            "enum": [
                              "blue_archive",
                              null
                            ]
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.recognition.status"
                },
                "payload": {
                  "not": {
                    "required": [
                      "error"
                    ]
                  }
                }
              }
            },
            {
              "properties": {
                "method": {
                  "const": "scanner.session.start"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "session_id",
                    "generation",
                    "scan_kind"
                  ],
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "scan_kind": {
                      "enum": [
                        "student",
                        "inventory",
                        "tactical_lobby"
                      ]
                    },

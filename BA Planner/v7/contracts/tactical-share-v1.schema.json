      "public_signature":{"type":"string","pattern":"^[^|]+\\|[^|]+\\|[^|]+$"},"defense_signature":{"type":"string","pattern":"^[^|]+\\|[^|]+$"},"attack_signature":{"type":"string","pattern":"^[^|]+\\|[^|]+$"},
      "result":{"enum":["win","loss"]},"source_identity":{"$ref":"#/$defs/id"},"source_type":{"enum":["v6_import","manual","battle_result","community_report"]}

    "timestamp":{"type":"string","format":"date-time"},
    "nullableString":{"type":["string","null"]},
    "share":{"type":"object","required":["version","share_id","scope_id","contributor_id","consent_scope","consented_at","shared_at","occurred_at","attempt_session_id","attempt_index","defense_snapshot_id","anonymous_opponent_id","season","patch","map","rank_difference","public_signature","defense_signature","attack_signature","result","source_identity","source_type"],"properties":{
      "version":{"const":1},"share_id":{"$ref":"#/$defs/id"},"scope_id":{"$ref":"#/$defs/id"},"contributor_id":{"$ref":"#/$defs/id"},"consent_scope":{"$ref":"#/$defs/id"},

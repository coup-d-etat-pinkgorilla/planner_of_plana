{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ba-planner.local/contracts/tactical-share-v1.schema.json",
  "title":"BA Planner opt-in tactical sharing protocol v1",
  "oneOf":[
    {"$ref":"#/$defs/stateRequest"},{"$ref":"#/$defs/prepareRequest"},{"$ref":"#/$defs/importRequest"},
    {"$ref":"#/$defs/withdrawRequest"},{"$ref":"#/$defs/analyticsRequest"},{"$ref":"#/$defs/successResponse"},{"$ref":"#/$defs/errorResponse"}

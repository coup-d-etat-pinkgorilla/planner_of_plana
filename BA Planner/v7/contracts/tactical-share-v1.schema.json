      "rank_difference_min":{"type":["integer","null"]},"rank_difference_max":{"type":["integer","null"]},"as_of":{"$ref":"#/$defs/timestamp"},
      "min_independent_contributors":{"type":"integer","minimum":1,"maximum":100},"min_independent_opponents":{"type":"integer","minimum":1,"maximum":100},"limit":{"type":"integer","minimum":1,"maximum":100}
    },"additionalProperties":false},
    "request":{"type":"object","required":["protocol","id","type","method","payload"],"properties":{"protocol":{"const":1},"id":{"type":"string","minLength":1},"type":{"const":"request"},"method":{"type":"string"},"payload":{"type":"object"}},"additionalProperties":false},
    "stateRequest":{"allOf":[{"$ref":"#/$defs/request"},{"properties":{"method":{"const":"tactical.v2.share.state.get"},"payload":{"type":"object","required":["profile_id"],"properties":{"profile_id":{"$ref":"#/$defs/profileId"}},"additionalProperties":false}}}]},
    "prepareRequest":{"allOf":[{"$ref":"#/$defs/request"},{"properties":{"method":{"const":"tactical.v2.share.prepare"},"payload":{"type":"object","required":["profile_id","match_id","scope_id","contributor_id","consent","attempt_session_id","attempt_index","shared_at","patch"],"properties":{"profile_id":{"$ref":"#/$defs/profileId"},"match_id":{"$ref":"#/$defs/id"},"scope_id":{"$ref":"#/$defs/id"},"contributor_id":{"$ref":"#/$defs/id"},"consent":{"type":"object","required":["enabled","scope_id","contributor_id","consented_at","include_original_media"],"properties":{"enabled":{"const":true},"scope_id":{"$ref":"#/$defs/id"},"contributor_id":{"$ref":"#/$defs/id"},"consented_at":{"$ref":"#/$defs/timestamp"},"include_original_media":{"const":false}},"additionalProperties":false},"attempt_session_id":{"$ref":"#/$defs/id"},"attempt_index":{"type":"integer","minimum":1},"shared_at":{"$ref":"#/$defs/timestamp"},"patch":{"type":"string","minLength":1}},"additionalProperties":false}}}]},
    "importRequest":{"allOf":[{"$ref":"#/$defs/request"},{"properties":{"method":{"const":"tactical.v2.share.import"},"payload":{"type":"object","required":["profile_id","shares","expected_revision","idempotency_key"],"properties":{"profile_id":{"$ref":"#/$defs/profileId"},"shares":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/$defs/share"}},"expected_revision":{"type":"integer","minimum":0},"idempotency_key":{"type":"string","minLength":1}},"additionalProperties":false}}}]},
    "withdrawRequest":{"allOf":[{"$ref":"#/$defs/request"},{"properties":{"method":{"const":"tactical.v2.share.withdraw"},"payload":{"type":"object","required":["profile_id","share_ids","withdrawn_at","reason","expected_revision","idempotency_key"],"properties":{"profile_id":{"$ref":"#/$defs/profileId"},"share_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"withdrawn_at":{"$ref":"#/$defs/timestamp"},"reason":{"type":"string","minLength":1},"expected_revision":{"type":"integer","minimum":0},"idempotency_key":{"type":"string","minLength":1}},"additionalProperties":false}}}]},
    "analyticsRequest":{"allOf":[{"$ref":"#/$defs/request"},{"properties":{"method":{"const":"tactical.v2.share.analytics.query"},"payload":{"type":"object","required":["profile_id","filters"],"properties":{"profile_id":{"$ref":"#/$defs/profileId"},"filters":{"$ref":"#/$defs/filters"}},"additionalProperties":false}}}]},
    "successResponse":{"type":"object","required":["protocol","id","type","method","payload"],"properties":{"protocol":{"const":1},"id":{"type":"string","minLength":1},"type":{"const":"response"},"method":{"enum":["tactical.v2.share.state.get","tactical.v2.share.prepare","tactical.v2.share.import","tactical.v2.share.withdraw","tactical.v2.share.analytics.query"]},"payload":{"type":"object","not":{"required":["error"]}}},"additionalProperties":false},
    "errorResponse":{"type":"object","required":["protocol","id","type","method","payload"],"properties":{"protocol":{"const":1},"id":{"type":"string","minLength":1},"type":{"const":"response"},"method":{"type":"string","pattern":"^tactical\\.v2\\.share\\."},"payload":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","retryable"],"properties":{"code":{"type":"string","minLength":1},"message":{"type":"string"},"retryable":{"type":"boolean"},"details":{"type":"object"}},"additionalProperties":false}},"additionalProperties":false}},"additionalProperties":false}
  }
}

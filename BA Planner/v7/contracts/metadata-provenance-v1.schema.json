{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ba-planner.local/contracts/metadata-provenance-v1.schema.json",
  "title": "BA Planner field value and provenance v1",
  "description": "Wrap one field value. Manual/generated provenance identifies a local version/table; rowSha may be null. No key or original client bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "provenance"
  ],
  "properties": {
    "value": {},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "versionId",
        "table",
        "rowSha",
        "tool",
        "extractedAt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "rowSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "extractedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      }
    }
  }
}
